{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs, event listening and the PMS Desktop commands (docs/ARCHITECTURE.md section 4). Plugins are driven from Rust only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "opener:default",
    "notification:default",
    "dialog:default",
    "autostart:default",
    "positioner:default",
    "allow-get-session",
    "allow-sign-in",
    "allow-sign-out",
    "allow-accept-first-run-notice",
    "allow-switch-company",
    "allow-list-projects",
    "allow-list-tasks",
    "allow-list-subtasks",
    "allow-search-tasks",
    "allow-recent-tasks",
    "allow-get-timer",
    "allow-start-timer",
    "allow-pause-timer",
    "allow-resume-timer",
    "allow-away-timer",
    "allow-stop-timer",
    "allow-list-break-reasons",
    "allow-start-break",
    "allow-end-break",
    "allow-submit-idle-note",
    "allow-overtime-decision",
    "allow-open-pms-web",
    "allow-app-info"
  ]
}
