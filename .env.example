# PMS Desktop — example environment for local development (copy values into your shell; nothing here is secret).
# Release builds take these at compile time from CI; debug builds also read them at runtime.
PMS_API_URL=http://localhost:8080/api/v1
AXIS_API_URL=https://stagingaxisapi.enjev.com
PMS_WEB_URL=https://stagingpms.enjev.com

# Debug builds only (ignored in release builds):
# PMS_DEV_EMAIL=you@example.com
# PMS_DEV_PASSWORD=
# PMS_DEV_FAST=1          # short idle/screenshot/overtime timers for testing
# PMS_DEV_SHOW_WINDOW=1   # open the window at start-up even when signed in
