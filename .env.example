# ──────────────────────────────────────────────────────────────────
# Workstatus Desktop Application — Environment Variables
# Copy this file to .env and fill in actual values
# ──────────────────────────────────────────────────────────────────

# ── API Configuration ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws
VITE_AXIS_API_URL=http://localhost:8081/api
VITE_AXIS_WEB_URL=http://localhost:3000

# ── Storage (Screenshot Uploads) ──────────────────────────────────
STORAGE_ENDPOINT=https://s3.enjev.com
STORAGE_ACCESS_KEY=vVpWQbO8JcvSS0ss
STORAGE_SECRET_KEY=8rIpwx5N4rji8KdLntuXuv3H0UMJZu3M
STORAGE_BUCKET=pms-staging
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL_PREFIX=https://s3.enjev.com/pms-staging

# ── Electron App Settings ─────────────────────────────────────────
ELECTRON_APP_NAME=Workstatus Desktop
ELECTRON_APP_VERSION=1.0.0

# ── Auto-Update ───────────────────────────────────────────────────
# URL where electron-updater checks for new releases
UPDATE_SERVER_URL=https://releases.workstatus.com

# ── Tracking Thresholds ──────────────────────────────────────────
# How often (in ms) to sync time progress to backend
HEARTBEAT_INTERVAL_MS=300000

# How often (in ms) to capture a screenshot
SCREENSHOT_INTERVAL_MS=600000

# Idle threshold (in ms) before pausing timer
IDLE_THRESHOLD_MS=300000

# How often (in ms) to poll active window title
ACTIVE_WINDOW_POLL_MS=30000

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=info
